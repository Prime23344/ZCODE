# Backend Environment
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-secret-change-in-production"
PORT=4000
NODE_ENV=development

# M-Pesa (sandbox/mock mode by default)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-sandbox-consumer-key
MPESA_CONSUMER_SECRET=your-sandbox-consumer-secret
MPESA_PASSKEY=your-sandbox-passkey
MPESA_BUSINESS_SHORTCODE=174379
MPESA_CALLBACK_URL=http://localhost:4000/api/payments/mpesa-callback

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Commission
DEFAULT_COMMISSION_RATE=0.10

# OTP (dev mode)
OTP_MOCK=true

# CORS
FRONTEND_URL=https://zcode-1.onrender.com
